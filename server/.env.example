# Copy to server/.env and fill in. Never commit .env.
MAIL_PORT=5177
INBOX_LIMIT=30

# Gmail — enable 2FA, then create an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# IONOS — IMAP (usually imap.ionos.de or imap.ionos.com, port 993)
IONOS_USER=you@yourdomain.com
IONOS_PASSWORD=your-mailbox-password
IONOS_HOST=imap.ionos.de
IONOS_PORT=993
