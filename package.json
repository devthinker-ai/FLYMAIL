{
  "name": "maleflymail",
  "version": "0.1.0",
  "private": true,
  "description": "MALEFLYMAIL — email replies via a live MaleCNS v1.0 male Drosophila brain on WebGPU",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5176",
    "mail": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5176",
    "typecheck": "tsc --noEmit",
    "data:download": "bash tools/download_data.sh",
    "data:csr": "python3 tools/build_csr.py",
    "fit": "python3 tools/fit_readout.py",
    "reports": "node tools/run_reports.mjs",
    "shoot": "node scripts/shoot.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@webgpu/types": "^0.1.69",
    "preact": "^10.26.5",
    "puppeteer-core": "^24.8.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
